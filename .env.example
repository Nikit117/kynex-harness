# The configuration the published score was measured with.
# Set these and run scripts/verify_against_extractbench.py with no --provider.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-10-21

AZURE_DI_ENDPOINT=
AZURE_DI_API_KEY=

# Convenience: a plain OpenAI key, no Azure resource.
#   python scripts/verify_against_extractbench.py --provider openai
OPENAI_API_KEY=
# ADH_MODEL_BASE_URL=https://api.openai.com/v1
# ADH_MODEL_DEPLOYMENT=gpt-5.4

# Any other OpenAI-compatible server works through the same profile:
#   python scripts/verify_against_extractbench.py --provider openai \
#       --base-url http://localhost:8000/v1 --model my-model
#
# A different provider or model is a different number, not a reproduction of the
# published one: compare the per-document shape rather than only the mean.
